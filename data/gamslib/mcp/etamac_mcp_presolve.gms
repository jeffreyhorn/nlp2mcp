k.fx(tfirst) = k0 * spda ** ninit + knew(tfirst);
kn.lo(t) = tol * i0 * ipm(t);
y.lo(t) = y0;
yn.lo(t) = tol * y0 * ln(t);
en.lo(t) = tol * e0 * ln(t);
nn.lo(t) = tol * n0 * ln(t);


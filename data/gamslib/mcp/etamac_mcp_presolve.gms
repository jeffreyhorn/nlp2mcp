nu_newcap.l(t) = newcap.m(t);
nu_newprod.l(t) = newprod.m(t);
nu_fnewelec.l(tfirst) = fnewelec.m(tfirst);
nu_newelec.l(t) = newelec.m(t);
nu_fnewnon.l(tfirst) = fnewnon.m(tfirst);
nu_newnon.l(t) = newnon.m(t);
nu_totalcap.l(t) = totalcap.m(t);
nu_ftotalprod.l(tfirst) = ftotalprod.m(tfirst);
nu_totalprod.l(t) = totalprod.m(t);
nu_costnrg.l(t) = costnrg.m(t);
nu_cc.l(t) = cc.m(t);
lam_tc.l(tlast) = abs(tc.m(tlast));

* Transfer variable marginals to bound multipliers
piL_k.l(t)$(abs(k.l(t) - k.lo(t)) < 1e-6) = abs(k.m(t));
piL_kn.l(t)$(abs(kn.l(t) - kn.lo(t)) < 1e-6) = abs(kn.m(t));
piL_y.l(t)$(abs(y.l(t) - y.lo(t)) < 1e-6) = abs(y.m(t));

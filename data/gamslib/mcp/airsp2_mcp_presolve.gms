* ============================================
* Variables (Primal + Multipliers)
* ============================================

* Primal variables: Original decision variables from the NLP
* Multipliers:
*   ν (nu_*): Free multipliers for equality constraints
*   λ (lam_*): Positive multipliers for inequality constraints
*   π^L (piL_*): Positive multipliers for lower bounds
*   π^U (piU_*): Positive multipliers for upper bounds

Variables
    z
;

Positive Variables
    x(i,j)
    bumped(j)
    lam_avail(i)
    lam_demand(j)
    piL_x(i,j)
    piL_bumped(j)
;

* ============================================
* NLP Pre-Solve (warm-start for MCP duals)
* ============================================

$onMultiR
$include "data/gamslib/raw/airsp2.gms"
$offMulti

* Transfer NLP duals to MCP multiplier initialization
lam_avail.l(i) = abs(avail.m(i));
lam_demand.l(j) = abs(demand.m(j));

* Transfer variable marginals to bound multipliers
piL_x.l(i,j)$(abs(x.l(i,j) - x.lo(i,j)) < 1e-6 and x.m(i,j) > 0) = x.m(i,j);
piL_bumped.l(j)$(abs(bumped.l(j) - bumped.lo(j)) < 1e-6 and bumped.m(j) > 0) = bumped.m(j);

* Reset any NA/UNDF warm-start multiplier levels to 0 (#1322)
lam_avail.l(i)$(NOT (lam_avail.l(i) > -inf and lam_avail.l(i) < inf)) = 0;
lam_demand.l(j)$(NOT (lam_demand.l(j) > -inf and lam_demand.l(j) < inf)) = 0;
piL_x.l(i,j)$(NOT (piL_x.l(i,j) > -inf and piL_x.l(i,j) < inf)) = 0;
piL_bumped.l(j)$(NOT (piL_bumped.l(j) > -inf and piL_bumped.l(j) < inf)) = 0;

* ============================================
* Equations
* ============================================

* Stationarity: One equation per primal variable (except objvar)
* Complementarity: Equations for inequalities and bounds
* Equality constraints: Original equality constraints

Equations
    stat_bumped(j)
    stat_x(i,j)
    comp_avail(i)
    comp_demand(j)
    comp_lo_bumped(j)
    comp_lo_x(i,j)
    cost
;

* ============================================
* Equation Definitions
* ============================================

$onMultiR
* Stationarity equations
stat_bumped(j).. costbumped(j) - lam_demand(j) - piL_bumped(j) =E= 0;
stat_x(i,j).. c(i,j) + lam_avail(i) + ((-1) * pcap(i,j)) * lam_demand(j) - piL_x(i,j) =E= 0;

* Inequality complementarity equations
comp_avail(i).. ((-1) * (sum(j, x(i,j)) - aircraft(i))) =G= 0;
comp_demand(j).. sum(i, pcap(i,j) * x(i,j)) + bumped(j) - fixeddemand(j) =G= 0;

* Lower bound complementarity equations
comp_lo_bumped(j).. bumped(j) - 0 =G= 0;
comp_lo_x(i,j).. x(i,j) - 0 =G= 0;

* Original equality equations
cost.. z =E= sum((i,j), c(i,j) * x(i,j)) + sum(j, costbumped(j) * bumped(j));

$offMulti

* ============================================
* Model MCP Declaration
* ============================================

* Each line pairs an equation with a variable:
*   equation.variable
*
* This defines the complementarity problem:
*   equation ⊥ variable
*
* Meaning: equation = 0 if variable > 0
*          equation ≥ 0 if variable = 0

Model mcp_model /
    stat_bumped.bumped,
    stat_x.x,
    comp_avail.lam_avail,
    comp_demand.lam_demand,
    cost.z,
    comp_lo_bumped.piL_bumped,
    comp_lo_x.piL_x
/;

* ============================================
* Solve Statement
* ============================================

Solve mcp_model using MCP;

Scalar nlp2mcp_obj_val;
nlp2mcp_obj_val = z.l;
Display nlp2mcp_obj_val;
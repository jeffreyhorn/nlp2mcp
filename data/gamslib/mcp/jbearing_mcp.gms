Alias(nx, i);
Alias(ny, j);

Parameters
    wq(nx)
;

Scalars
    b /10/
    e /0.1/
    hx /0/
    hy /0/
    area /0/
;

hx = 2 * pi / 51;
hy = 2 * b / 51;
wq(nx) = power(1 + e * cos((ord(nx) - 1) * hx), 3);

execError = 0;


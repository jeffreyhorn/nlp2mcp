eta(i) = (sigma(i) - 1) / sigma(i);
phi(i) = (psi(i) + 1) / psi(i);
X0(i,j) = SAM(i,j);
Xp0(i) = SAM(i,"HOH");
Xg0(i) = SAM(i,"GOV");
Xv0(i) = SAM(i,"INV");
E0(i) = SAM(i,"EXT");
M0(i) = SAM("EXT",i);
Sp0 = SAM("INV","HOH");
Sg0 = SAM("INV","GOV");
Td0 = SAM("GOV","HOH");
Tz0(j) = SAM("IDT",j);
Tm0(j) = SAM("TRF",j);
Sf = SAM("INV","EXT");
alpha(i) = Xp0(i) / sum(j, Xp0(j));
mu(i) = Xg0(i) / sum(j, Xg0(j));
Q0(i) = Xp0(i) + Xg0(i) + Xv0(i) + sum(j, X0(i,j));
taum(j) = Tm0(j) / M0(j);
ssg = Sg0 / (Td0 + sum(j, Tz0(j)) + sum(j, Tm0(j)));
lambda(i) = Xv0(i) / (Sp0 + Sg0 + Sf);
D0(i) = (Q0(i) - (1 + taum(i)) * M0(i)) / (1 / eta(i));
RT0(j) = (1 - eta(j)) / eta(j) * D0(j);
deltam(i) = (1 + taum(i)) * M0(i) ** (1 - eta(i)) / ((1 + taum(i)) * M0(i) ** (1 - eta(i)) + 1 / eta(i) * D0(i) ** (1 - eta(i)));
deltad(i) = 1 / eta(i) * D0(i) ** (1 - eta(i)) / ((1 + taum(i)) * M0(i) ** (1 - eta(i)) + 1 / eta(i) * D0(i) ** (1 - eta(i)));
xid(i) = D0(i) ** (1 - phi(i)) / (E0(i) ** (1 - phi(i)) + D0(i) ** (1 - phi(i)));
xie(i) = E0(i) ** (1 - phi(i)) / (E0(i) ** (1 - phi(i)) + D0(i) ** (1 - phi(i)));
F0(h,j) = SAM(h,j) - SAM(h,j) / sum(k, SAM(k,j)) * RT0(j);
gamma(i) = Q0(i) / (deltam(i) * M0(i) ** eta(i) + deltad(i) * D0(i) ** eta(i)) ** (1 / eta(i));
Y0(j) = sum(h, F0(h,j));
FF(h) = sum(j, F0(h,j));
beta(h,j) = F0(h,j) / sum(k, F0(k,j));
Z0(j) = Y0(j) + sum(i, X0(i,j));
ssp = Sp0 / (sum(h, FF(h)) + sum(j, RT0(j)));
taud = Td0 / (sum(h, FF(h)) + sum(j, RT0(j)));
b(j) = Y0(j) / prod(h, F0(h,j) ** beta(h,j));
tauz(j) = Tz0(j) / Z0(j);
ax(i,j) = X0(i,j) / Z0(j);
ay(j) = Y0(j) / Z0(j);
theta(i) = Z0(i) / (xie(i) * E0(i) ** phi(i) + xid(i) * D0(i) ** phi(i)) ** (1 / phi(i));

execError = 0;


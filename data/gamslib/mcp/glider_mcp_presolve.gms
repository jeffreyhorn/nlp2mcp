* Transfer NLP duals to MCP multiplier initialization
nu_tf_eqn.l = tf_eqn.m;
nu_rdef.l(i) = rdef.m(i);
nu_udef.l(i) = udef.m(i);
nu_wdef.l(i) = wdef.m(i);
nu_vdef.l(i) = vdef.m(i);

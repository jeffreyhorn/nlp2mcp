;

* ============================================
* Equation Definitions
* ============================================

$onMultiR
* Stationarity equations
stat_cl(h).. (((-1) * (sqr(v(h)) * S * rho * 0.5 * c1 * 2 * cl(h))) * nu_Ddef(h))$(i(h)) + (((-1) * (sqr(v(h)) * S * rho * 0.5)) * nu_Ldef(h))$(i(h)) - piL_cl(h) + piU_cl(h) =E= 0;
stat_d(h).. nu_Ddef(h)$(i(h)) + (((-1) * (m * ((-1) * (v(h) * vel("x",h) / sqr(v(h)))) / sqr(m))) * nu_vx_dot_def(h))$(i(h)) + (((-1) * (m * ((-1) * (v(h) * w(h) / sqr(v(h)))) / sqr(m))) * nu_vy_dot_def(h))$(i(h)) =E= 0;
stat_l(h).. nu_Ldef(h)$(i(h)) + (((-1) * (m * v(h) * w(h) * (-1) / sqr(v(h)) / sqr(m))) * nu_vx_dot_def(h))$(i(h)) + (((-1) * (m * v(h) * vel("x",h) / sqr(v(h)) / sqr(m))) * nu_vy_dot_def(h))$(i(h)) =E= 0;
stat_pos(c,h).. (-1)$(sameas(c, 'x') and sameas(h, 'h50')) + ((((-1) * (2 * (pos(c,h) / r_0 - 2.5) * 1 / r_0 ** 1)) * nu_rdef(h))$(i(h)))$(sameas(c, 'x')) + nu_pos_eqn(c,h)$(i(h)) + (((-1) * nu_pos_eqn(c,h+1))$(i(h+1)))$(ord(h) <= card(h) - 1) - piL_pos(c,h) =E= 0;
stat_r(h).. nu_rdef(h)$(i(h)) + (((-1) * (((-1) * (exp(((-1) * r(h))) * u_c)) - u_c * (1 - r(h)) * exp(((-1) * r(h))))) * nu_udef(h))$(i(h)) =E= 0;
stat_step.. ((-1) * nh) * nu_tf_eqn + sum((c,i), (((-1) * (vel(c,i) * 0.5)) * nu_pos_eqn(c,i))$(i(i))) + sum((c,i), (((-1) * (v_dot(c,i) * 0.5)) * nu_vel_eqn(c,i))$(i(i))) - piL_step =E= 0;
stat_t_f.. nu_tf_eqn =E= 0;
stat_u(h).. nu_udef(h)$(i(h)) + nu_wdef(h)$(i(h)) =E= 0;
stat_v(h).. nu_vdef(h)$(i(h)) + (((-1) * (0.5 * (c0 + c1 * sqr(cl(h))) * rho * S * 2 * v(h))) * nu_Ddef(h))$(i(h)) + (((-1) * (0.5 * cl(h) * rho * S * 2 * v(h))) * nu_Ldef(h))$(i(h)) + (((-1) * (m * (((-1) * (((-1) * l(h)) * w(h))) / sqr(v(h)) - ((-1) * (d(h) * vel("x",h))) / sqr(v(h))) / sqr(m))) * nu_vx_dot_def(h))$(i(h)) + (((-1) * (m * (((-1) * (l(h) * vel("x",h))) / sqr(v(h)) - ((-1) * (d(h) * w(h))) / sqr(v(h))) / sqr(m))) * nu_vy_dot_def(h))$(i(h)) - piL_v(h) =E= 0;
stat_v_dot(c,h).. ((nu_vx_dot_def(h)$(i(h)))$(sameas(c, 'x')) + (((-1) * (0.5 * step)) * nu_vel_eqn(c,h))$(i(h)) + ((((-1) * (0.5 * step)) * nu_vel_eqn(c,h+1))$(i(h+1)))$(ord(h) <= card(h) - 1) + (nu_vy_dot_def(h)$(i(h)))$(sameas(c, 'y')))$(sameas(c, 'x') or ord(h) <= card(h) - 1 or sameas(c, 'y')) =E= 0;
stat_vel(c,h).. ((((-1) * (1 / (2 * sqrt(sqr(vel(c,h)) + sqr(w(h)))) * 2 * vel(c,h))) * nu_vdef(h))$(i(h)))$(sameas(c, 'x')) + ((((-1) * (m * ((-1) * (v(h) * d(h) / sqr(v(h)))) / sqr(m))) * nu_vx_dot_def(h))$(i(h)))$(sameas(c, 'x')) + ((((-1) * (m * v(h) * l(h) / sqr(v(h)) / sqr(m))) * nu_vy_dot_def(h))$(i(h)))$(sameas(c, 'x')) + (((-1) * (0.5 * step)) * nu_pos_eqn(c,h))$(i(h)) + ((((-1) * (0.5 * step)) * nu_pos_eqn(c,h+1))$(i(h+1)))$(ord(h) <= card(h) - 1) + nu_vel_eqn(c,h)$(i(h)) + (((-1) * nu_vel_eqn(c,h+1))$(i(h+1)))$(ord(h) <= card(h) - 1) + (((-1) * nu_wdef(h))$(i(h)))$(sameas(c, 'y')) - piL_vel(c,h) =E= 0;
stat_w(h).. nu_wdef(h)$(i(h)) + (((-1) * (1 / (2 * sqrt(sqr(vel("x",h)) + sqr(w(h)))) * 2 * w(h))) * nu_vdef(h))$(i(h)) + (((-1) * (m * v(h) * ((-1) * l(h)) / sqr(v(h)) / sqr(m))) * nu_vx_dot_def(h))$(i(h)) + (((-1) * (m * ((-1) * (v(h) * d(h) / sqr(v(h)))) / sqr(m))) * nu_vy_dot_def(h))$(i(h)) =E= 0;

* Lower bound complementarity equations
comp_lo_cl(h).. cl(h) - 0 =G= 0;
comp_lo_pos(c,h)$(has_pos_lo(c,h)).. pos(c,h) - pos_lo_param(c,h) =G= 0;
comp_lo_step.. step - 0 =G= 0;
comp_lo_v(h).. v(h) - 0.01 =G= 0;
comp_lo_vel(c,h)$(has_vel_lo(c,h)).. vel(c,h) - vel_lo_param(c,h) =G= 0;

* Upper bound complementarity equations
comp_up_cl(h).. 1.4 - cl(h) =G= 0;

* Original equality equations
tf_eqn.. t_f =E= step * nh;
rdef(i).. r(i) =E= sqr(pos("x",i) / r_0 - 2.5);
udef(i).. u(i) =E= u_c * (1 - r(i)) * exp(((-1) * r(i)));
wdef(i).. w(i) =E= vel("y",i) - u(i);
vdef(i).. v(i) =E= sqrt(sqr(vel("x",i)) + sqr(w(i)));
Ddef(i).. d(i) =E= 0.5 * (c0 + c1 * sqr(cl(i))) * rho * S * sqr(v(i));
Ldef(i).. l(i) =E= 0.5 * cl(i) * rho * S * sqr(v(i));
vx_dot_def(i).. v_dot("x",i) =E= (((-1) * l(i)) * w(i) / v(i) - d(i) * vel("x",i) / v(i)) / m;
vy_dot_def(i).. v_dot("y",i) =E= (l(i) * vel("x",i) / v(i) - d(i) * w(i) / v(i)) / m - g;
obj.. final_x =E= pos("x","h50");
pos_eqn(c,i)$(ord(i) > 1).. pos(c,i) =E= pos(c,i-1) + 0.5 * step * (vel(c,i) + vel(c,i-1));
vel_eqn(c,i)$(ord(i) > 1).. vel(c,i) =E= vel(c,i-1) + 0.5 * step * (v_dot(c,i) + v_dot(c,i-1));

$offMulti

* ============================================
* Fix inactive variable instances
* ============================================

* Variables whose paired MCP equation is conditioned must be
* fixed for excluded instances to satisfy MCP matching.

v_dot.fx(c,h)$(not (sameas(c, 'x') or ord(h) <= card(h) - 1 or sameas(c, 'y'))) = 0;
piL_pos.fx(c,h)$(not has_pos_lo(c,h)) = 0;
piL_vel.fx(c,h)$(not has_vel_lo(c,h)) = 0;
nu_pos_eqn.fx(c,i)$(not (ord(i) > 1)) = 0;
nu_vel_eqn.fx(c,i)$(not (ord(i) > 1)) = 0;

* ============================================
* Model MCP Declaration
* ============================================

* Each line pairs an equation with a variable:
*   equation.variable
*
* This defines the complementarity problem:
*   equation ⊥ variable
*
* Meaning: equation = 0 if variable > 0
*          equation ≥ 0 if variable = 0

Model mcp_model /
    stat_cl.cl,
    stat_d.d,
    stat_l.l,
    stat_pos.pos,
    stat_r.r,
    stat_step.step,
    stat_t_f.t_f,
    stat_u.u,
    stat_v.v,
    stat_v_dot.v_dot,
    stat_vel.vel,
    stat_w.w,
    Ddef.nu_Ddef,
    Ldef.nu_Ldef,
    obj.final_x,
    pos_eqn.nu_pos_eqn,
    rdef.nu_rdef,
    tf_eqn.nu_tf_eqn,
    udef.nu_udef,
    vdef.nu_vdef,
    vel_eqn.nu_vel_eqn,
    vx_dot_def.nu_vx_dot_def,
    vy_dot_def.nu_vy_dot_def,
    wdef.nu_wdef,
    comp_lo_cl.piL_cl,
    comp_lo_pos.piL_pos,
    comp_lo_step.piL_step,
    comp_lo_v.piL_v,
    comp_lo_vel.piL_vel,
    comp_up_cl.piU_cl
/;

* ============================================
* Solve Statement
* ============================================


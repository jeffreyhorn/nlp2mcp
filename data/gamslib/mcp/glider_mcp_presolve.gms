nu_vel_eqn.l(c,i) = vel_eqn.m(c,i);

* Transfer variable marginals to bound multipliers
piL_pos.l(c,h)$(abs(pos.l(c,h) - pos.lo(c,h)) < 1e-6) = abs(pos.m(c,h));
piL_vel.l(c,h)$(abs(vel.l(c,h) - vel.lo(c,h)) < 1e-6) = abs(vel.m(c,h));
piL_cl.l(h)$(abs(cl.l(h) - cl.lo(h)) < 1e-6) = abs(cl.m(h));
piL_v.l(h)$(abs(v.l(h) - v.lo(h)) < 1e-6) = abs(v.m(h));
piL_step.l$(abs(step.l - step.lo) < 1e-6) = abs(step.m);
piU_cl.l(h)$(abs(cl.l(h) - cl.up(h)) < 1e-6) = abs(cl.m(h));

* Reset any NA/UNDF warm-start multiplier levels to 0 (#1322)
nu_tf_eqn.l$(NOT (nu_tf_eqn.l > -inf and nu_tf_eqn.l < inf)) = 0;
nu_rdef.l(i)$(NOT (nu_rdef.l(i) > -inf and nu_rdef.l(i) < inf)) = 0;

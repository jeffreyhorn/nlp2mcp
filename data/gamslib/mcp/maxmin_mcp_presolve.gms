$onText
Generated by nlp2mcp

This file contains the KKT (Karush-Kuhn-Tucker) conditions
for the original NLP model, transformed into MCP format.

KKT System Components:
  - Stationarity: ∇f + J^T λ + J^T ν - π^L + π^U = 0
  - Complementarity: g(x) ⊥ λ, h(x) = 0, bounds ⊥ π
  - Dual feasibility: λ, π^L, π^U ≥ 0
  - Primal feasibility: g(x) ≤ 0, h(x) = 0, lo ≤ x ≤ up
$offText

* ============================================
* Original Model Declarations
* ============================================

Sets
    d /x, y/
    n /p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13/
    low(n,n)
;

Alias(n, nn);

Scalars
    p /0/
    bnd /0/
;

$onImplicitAssign
low(n,nn) = ord(n) > ord(nn);
$offImplicitAssign

* ============================================
* Variables (Primal + Multipliers)
* ============================================

* Primal variables: Original decision variables from the NLP
* Multipliers:
*   ν (nu_*): Free multipliers for equality constraints
*   λ (lam_*): Positive multipliers for inequality constraints
*   π^L (piL_*): Positive multipliers for lower bounds
*   π^U (piU_*): Positive multipliers for upper bounds

Variables
    point(n,d)
    mindist
    nu_point_fx_p1_x
    nu_point_fx_p1_y
;

Positive Variables
    lam_mindist1a(n,n)
    piL_point(n,d)
    piU_point(n,d)
;

* ============================================
* NLP Pre-Solve (warm-start for MCP duals)
* ============================================

$onMultiR
$include "data/gamslib/raw/maxmin.gms"
$offMulti

* Transfer NLP duals to MCP multiplier initialization
lam_mindist1a.l(n,nn) = abs(mindist1a.m(n,nn));

* Transfer variable marginals to bound multipliers
piL_point.l(n,d)$(abs(point.l(n,d) - point.lo(n,d)) < 1e-6) = abs(point.m(n,d));
piU_point.l(n,d)$(abs(point.l(n,d) - point.up(n,d)) < 1e-6) = abs(point.m(n,d));

* Transfer fixed-variable marginals to _fx_ multipliers (#1462)
nu_point_fx_p1_x.l = point.m('p1','x');
nu_point_fx_p1_y.l = point.m('p1','y');

* Reset any NA/UNDF warm-start multiplier levels to 0 (#1322)
lam_mindist1a.l(n,nn)$(NOT (lam_mindist1a.l(n,nn) > -inf and lam_mindist1a.l(n,nn) < inf)) = 0;
piL_point.l(n,d)$(NOT (piL_point.l(n,d) > -inf and piL_point.l(n,d) < inf)) = 0;
piU_point.l(n,d)$(NOT (piU_point.l(n,d) > -inf and piU_point.l(n,d) < inf)) = 0;
nu_point_fx_p1_x.l$(NOT (nu_point_fx_p1_x.l > -inf and nu_point_fx_p1_x.l < inf)) = 0;
nu_point_fx_p1_y.l$(NOT (nu_point_fx_p1_y.l > -inf and nu_point_fx_p1_y.l < inf)) = 0;

* ============================================
* #1449 (Layer 4): unfix elements fixed by the source $include but
* enforced in the MCP via an active _fx_ complementarity equation
* (else PATH drops the fixed column, leaving the _fx_ row unmatched).
* ============================================
point.lo('p1','x') = -inf;
point.up('p1','x') = +inf;
point.lo('p1','y') = -inf;
point.up('p1','y') = +inf;

* ============================================
* Equations
* ============================================

* Stationarity: One equation per primal variable (except objvar)
* Complementarity: Equations for inequalities and bounds
* Equality constraints: Original equality constraints

Equations
    stat_mindist
    stat_point(n,d)
    comp_mindist1a(n,n)
    comp_lo_point(n,d)
    comp_up_point(n,d)
    point_fx_p1_x
    point_fx_p1_y
;

* ============================================
* Equation Definitions
* ============================================

* Index aliases to avoid 'Set is under control already' error
* (GAMS Error 125 when equation domain index is reused in sum)
Alias(d, d__);

$onMultiR
* Stationarity equations
stat_mindist.. -1 + sum((n,nn)$(low(n,nn)), lam_mindist1a(n,nn)$(nn(nn))) =E= 0;
stat_point(n,d).. nu_point_fx_p1_x$(sameas(n, 'p1') and sameas(d, 'x')) + nu_point_fx_p1_y$(sameas(n, 'p1') and sameas(d, 'y')) + sum(nn, ((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n,d__) - point(nn,d__))))) * 2 * (point(n,d) - point(nn,d)))) * lam_mindist1a(n,nn))$(nn(nn)))$(low(n,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+9,d__) - point(nn,d__))))) * 2 * (point(n+9,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+9,nn))$(nn(nn)))$(ord(n) <= card(n) - 9))$(low(n+9,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+10,d__) - point(nn,d__))))) * 2 * (point(n+10,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+10,nn))$(nn(nn)))$(ord(n) <= card(n) - 10))$(low(n+10,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+11,d__) - point(nn,d__))))) * 2 * (point(n+11,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+11,nn))$(nn(nn)))$(ord(n) <= card(n) - 11))$(low(n+11,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+12,d__) - point(nn,d__))))) * 2 * (point(n+12,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+12,nn))$(nn(nn)))$(ord(n) <= card(n) - 12))$(low(n+12,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+1,d__) - point(nn,d__))))) * 2 * (point(n+1,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+1,nn))$(nn(nn)))$(ord(n) <= card(n) - 1))$(low(n+1,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+2,d__) - point(nn,d__))))) * 2 * (point(n+2,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+2,nn))$(nn(nn)))$(ord(n) <= card(n) - 2))$(low(n+2,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+3,d__) - point(nn,d__))))) * 2 * (point(n+3,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+3,nn))$(nn(nn)))$(ord(n) <= card(n) - 3))$(low(n+3,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+4,d__) - point(nn,d__))))) * 2 * (point(n+4,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+4,nn))$(nn(nn)))$(ord(n) <= card(n) - 4))$(low(n+4,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+5,d__) - point(nn,d__))))) * 2 * (point(n+5,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+5,nn))$(nn(nn)))$(ord(n) <= card(n) - 5))$(low(n+5,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+6,d__) - point(nn,d__))))) * 2 * (point(n+6,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+6,nn))$(nn(nn)))$(ord(n) <= card(n) - 6))$(low(n+6,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+7,d__) - point(nn,d__))))) * 2 * (point(n+7,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+7,nn))$(nn(nn)))$(ord(n) <= card(n) - 7))$(low(n+7,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n+8,d__) - point(nn,d__))))) * 2 * (point(n+8,d) - point(nn,d)) * (-1))) * lam_mindist1a(n+8,nn))$(nn(nn)))$(ord(n) <= card(n) - 8))$(low(n+8,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-9,d__) - point(nn,d__))))) * 2 * (point(n-9,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-9,nn))$(nn(nn)))$(ord(n) > 9))$(low(n-9,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-8,d__) - point(nn,d__))))) * 2 * (point(n-8,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-8,nn))$(nn(nn)))$(ord(n) > 8))$(low(n-8,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-7,d__) - point(nn,d__))))) * 2 * (point(n-7,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-7,nn))$(nn(nn)))$(ord(n) > 7))$(low(n-7,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-6,d__) - point(nn,d__))))) * 2 * (point(n-6,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-6,nn))$(nn(nn)))$(ord(n) > 6))$(low(n-6,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-5,d__) - point(nn,d__))))) * 2 * (point(n-5,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-5,nn))$(nn(nn)))$(ord(n) > 5))$(low(n-5,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-4,d__) - point(nn,d__))))) * 2 * (point(n-4,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-4,nn))$(nn(nn)))$(ord(n) > 4))$(low(n-4,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-3,d__) - point(nn,d__))))) * 2 * (point(n-3,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-3,nn))$(nn(nn)))$(ord(n) > 3))$(low(n-3,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-2,d__) - point(nn,d__))))) * 2 * (point(n-2,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-2,nn))$(nn(nn)))$(ord(n) > 2))$(low(n-2,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-1,d__) - point(nn,d__))))) * 2 * (point(n-1,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-1,nn))$(nn(nn)))$(ord(n) > 1))$(low(n-1,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-10,d__) - point(nn,d__))))) * 2 * (point(n-10,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-10,nn))$(nn(nn)))$(ord(n) > 10))$(low(n-10,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-11,d__) - point(nn,d__))))) * 2 * (point(n-11,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-11,nn))$(nn(nn)))$(ord(n) > 11))$(low(n-11,nn))) + sum(nn, (((((-1) * (1 / (2 * sqrt(sum(d__, sqr(point(n-12,d__) - point(nn,d__))))) * 2 * (point(n-12,d) - point(nn,d)) * (-1))) * lam_mindist1a(n-12,nn))$(nn(nn)))$(ord(n) > 12))$(low(n-12,nn))) - piL_point(n,d) + piU_point(n,d) =E= 0;

* Inequality complementarity equations
comp_mindist1a(n,nn)$(low(n,nn)).. ((-1) * (mindist - sqrt(sum(d, sqr(point(n,d) - point(nn,d)))))) =G= 0;

* Lower bound complementarity equations
comp_lo_point(n,d).. point(n,d) - 0 =G= 0;

* Upper bound complementarity equations
comp_up_point(n,d).. 1 - point(n,d) =G= 0;

* Original equality equations
point_fx_p1_x.. point("p1","x") - 0 =E= 0;
point_fx_p1_y.. point("p1","y") - 0 =E= 0;

$offMulti

* ============================================
* Fix inactive variable instances
* ============================================

* Variables whose paired MCP equation is conditioned must be
* fixed for excluded instances to satisfy MCP matching.

lam_mindist1a.fx(n,nn)$(not (low(n,nn))) = 0;

* ============================================
* Model MCP Declaration
* ============================================

* Each line pairs an equation with a variable:
*   equation.variable
*
* This defines the complementarity problem:
*   equation ⊥ variable
*
* Meaning: equation = 0 if variable > 0
*          equation ≥ 0 if variable = 0

Model mcp_model /
    stat_mindist.mindist,
    stat_point.point,
    comp_mindist1a.lam_mindist1a,
    point_fx_p1_x.nu_point_fx_p1_x,
    point_fx_p1_y.nu_point_fx_p1_y,
    comp_lo_point.piL_point,
    comp_up_point.piU_point
/;

* ============================================
* Solve Statement
* ============================================

Solve mcp_model using MCP;

Scalar nlp2mcp_obj_val;
nlp2mcp_obj_val = mindist.l;
Display nlp2mcp_obj_val;